# Lake Cement MIS — Backend Configuration (template)
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# Database — a Postgres database + role dedicated to this app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lcl_mis
DB_USER=lcl_admin
DB_PASSWORD=change-me

# JWT — secret key used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRES_IN=8h

# CORS — restrict to your actual frontend origin in production
ALLOWED_ORIGIN=*
