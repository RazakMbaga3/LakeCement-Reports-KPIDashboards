# Lake Cement MIS — Backend Configuration (template)
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# Database — a Postgres database + role dedicated to this app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lcl_mis
DB_USER=lcl_admin
DB_PASSWORD=change-me

# JWT — secret key used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRES_IN=8h

# CORS — restrict to your actual frontend origin(s) in production.
# Comma-separated list, e.g.: http://192.168.1.20,http://mis.lakecement.local
ALLOWED_ORIGIN=*

# Login hardening
LOCKOUT_MAX_ATTEMPTS=5   # failed logins before the account locks
LOCKOUT_MINUTES=15       # how long a lockout lasts
AUTH_RATE_LIMIT=30       # max /api/auth requests per IP per 5 minutes

# Morning KPI digest email — leave SMTP_HOST empty to disable entirely.
# The digest runs on DIGEST_CRON and can be triggered manually via
# POST /api/mis/digest/send (admin/md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=mis@lakecement.co.tz
DIGEST_TO=               # comma-separated, e.g. md@lakecement.co.tz,planthead@lakecement.co.tz
DIGEST_CRON=0 6 * * *    # 06:00 every day

# Monitoring & alerting (Phase 6)
LOG_LEVEL=info               # pino level; logs go to stdout + backend/logs/ (14-day rotation)
WATCHDOG_CRON=*/15 * * * *   # alert checks; set to 'off' to disable
ALERT_TO=                    # alert recipients (falls back to DIGEST_TO)
MISSED_ENTRY_FORMS=kiln,cement-mill,quality,dispatch,power-cons,mines
MISSED_ENTRY_CUTOFF=10:00    # local time after which a missing form alerts
DISK_MIN_FREE_GB=5           # below this the health check degrades + alerts
BACKUP_DIR=                  # where pg_dump files land — SECOND disk or network share.
                             # Setting this enables nightly backups + backup-age health checks.
BACKUP_MAX_AGE_HOURS=26
BACKUP_CRON=30 2 * * *       # nightly backup time (02:30); 'off' disables the schedule
BACKUP_KEEP_DAYS=14          # dumps older than this are pruned after each backup
PG_BIN=                      # PostgreSQL bin dir if pg_dump isn't on PATH,
                             # e.g. C:\Program Files\Odoo 15.0.20250101\PostgreSQL\bin
PG_ADMIN_USER=               # only needed for restore/drill if the app user
PG_ADMIN_PASSWORD=           # lacks CREATEDB (else: ALTER USER <user> CREATEDB;)

# Deployment (Phase 7)
TRUST_PROXY=0                # set 1 when running behind Nginx/IIS so req.ip is the real client
METRICS_TOKEN=               # optional static bearer token for a Prometheus scraper
CLIENT_ERROR_RATE_LIMIT=60   # browser error reports per IP per 5 min

# Odoo integration (Phase 4 — read-only connector, see docs/TECHNICAL_SPEC.md
# §11). Two INDEPENDENT Odoo connections, either one enables the sync
# scheduler (see server.js) — odooSync.js's PULLS list decides what each
# actually pulls with:
#
# 1. Generic Odoo External API (backend/services/odooClient.js) — a real
#    Odoo user login via XML/JSON-RPC. Not used by any pull yet.
ODOO_URL=                    # e.g. http://192.168.1.10:8069 (no trailing slash)
ODOO_DB=                     # Odoo database name
ODOO_USERNAME=                # service-account login (email/username)
ODOO_API_KEY=                 # service-account API key — Odoo user's own
                              # Settings > Account Security > API Keys, NOT their password
#
# 2. Dispatch Report connector (backend/services/odooDispatchClient.js) —
#    a bespoke endpoint the Odoo team built for this app, a single opaque
#    key rather than a full Odoo login. Wired up and pulling since
#    2026-08-05 (services/odooDispatchSync.js) — feeds the standalone
#    Dispatch report, not the dashboard's "Despatch / Day" KPI card.
ODOO_DISPATCH_URL=           # full endpoint URL, e.g. http://<host>:8069/dispatch_report
ODOO_DISPATCH_API_KEY=       # opaque key issued by the Odoo team for this endpoint
#
ODOO_SYNC_CRON=off            # cron spec for the daily pull; 'off' disables even if a URL above is set
