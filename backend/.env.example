# Lake Cement MIS — Backend Configuration (template)
# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5000

# Database — a Postgres database + role dedicated to this app
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lcl_mis
DB_USER=lcl_admin
DB_PASSWORD=change-me
DB_SSL=false             # set true for DigitalOcean/other managed Postgres
                         # (they require SSL); leave false for a local/same-host DB

# JWT — secret key used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-real-secret
JWT_EXPIRES_IN=8h

# CORS — restrict to your actual frontend origin(s) in production.
# Comma-separated list, e.g.: http://192.168.1.20,http://mis.lakecement.local
ALLOWED_ORIGIN=*

# Login hardening
LOCKOUT_MAX_ATTEMPTS=5   # failed logins before the account locks
LOCKOUT_MINUTES=15       # how long a lockout lasts
AUTH_RATE_LIMIT=30       # max LOGIN + CHANGE-PASSWORD attempts per IP per 5 min.
                         # Deliberately not applied to GET /api/auth/me, which every
                         # page load calls: the limiter keys on IP, so covering /me
                         # made a whole office behind one NAT share 30 requests.

# Where the app is reachable from a user's browser. Used to build the links
# in invitation, password-reset and email-verification messages, so it must
# be the address staff actually type — not localhost, and no trailing slash.
#   e.g. https://smr.lakecement.co.tz   or   http://192.168.1.20
# Deliberately has NO default: a link built against the wrong host looks like
# it should work and doesn't. When this is unset, those emails refuse to send
# and say why, rather than mailing out a broken link.
APP_URL=

# Mail — used by the account emails (invitation / password reset / address
# verification), the morning KPI digest and the watchdog alerts.
# Leave SMTP_HOST empty to disable sending entirely; set DIGEST_TRANSPORT=json
# to exercise the whole pipeline without a mail server (tests use this).
# The digest runs on DIGEST_CRON and can be triggered manually via
# POST /api/mis/digest/send (admin/md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=digital@lakecement.co.tz
DIGEST_TO=               # comma-separated, e.g. md@lakecement.co.tz,planthead@lakecement.co.tz
DIGEST_CRON=0 6 * * *    # 06:00 every day

# Monitoring & alerting (Phase 6)
LOG_LEVEL=info               # pino level; logs go to stdout + backend/logs/ (14-day rotation)
WATCHDOG_CRON=*/15 * * * *   # alert checks; set to 'off' to disable
ALERT_TO=                    # alert recipients (falls back to DIGEST_TO)
MISSED_ENTRY_FORMS=kiln,cement-mill,quality,dispatch,power-cons,mines
MISSED_ENTRY_CUTOFF=10:00    # local time after which a missing form alerts
DISK_MIN_FREE_GB=5           # below this the health check degrades + alerts
BACKUP_DIR=                  # where pg_dump files land — SECOND disk or network share.
                             # Setting this enables nightly backups + backup-age health checks.
BACKUP_MAX_AGE_HOURS=26
BACKUP_CRON=30 2 * * *       # nightly backup time (02:30); 'off' disables the schedule
BACKUP_KEEP_DAYS=14          # dumps older than this are pruned after each backup
RESTORE_DRILL_CRON=30 3 1 * * # monthly restore-drill time (03:30 on the 1st);
                             # 'off' disables; only runs at all if BACKUP_DIR is set
PG_BIN=                      # PostgreSQL bin dir if pg_dump isn't on PATH,
                             # e.g. C:\Program Files\Odoo 15.0.20250101\PostgreSQL\bin
PG_ADMIN_USER=               # only needed for restore/drill if the app user
PG_ADMIN_PASSWORD=           # lacks CREATEDB (else: ALTER USER <user> CREATEDB;)

# Deployment (Phase 7)
TRUST_PROXY=0                # set 1 when running behind Nginx/IIS so req.ip is the real client
METRICS_TOKEN=               # optional static bearer token for a Prometheus scraper
CLIENT_ERROR_RATE_LIMIT=60   # browser error reports per IP per 5 min

# Odoo integration (Phase 4 — read-only connector, see docs/TECHNICAL_SPEC.md
# §11). Several INDEPENDENT Odoo connections; any one of them enables the
# sync scheduler (see server.js) — odooSync.js's PULLS list decides what
# each actually pulls with:
#
# 1. Generic Odoo External API (backend/services/odooClient.js) — a real
#    Odoo user login via XML/JSON-RPC. Not used by any pull yet.
ODOO_URL=                    # e.g. http://192.168.1.10:8069 (no trailing slash)
ODOO_DB=                     # Odoo database name
ODOO_USERNAME=                # service-account login (email/username)
ODOO_API_KEY=                 # service-account API key — Odoo user's own
                              # Settings > Account Security > API Keys, NOT their password
#
# 2. Dispatch Report connector (backend/services/odooDispatchClient.js) —
#    a bespoke endpoint the Odoo team built for this app, a single opaque
#    key rather than a full Odoo login. Wired up and pulling since
#    2026-08-05 (services/odooDispatchSync.js) — feeds the standalone
#    Dispatch report, not the dashboard's "Despatch / Day" KPI card.
#    Moved to the PRODUCTION ERP 2026-09-23 — same key as
#    ODOO_PRODUCTION_API_KEY below.
ODOO_DISPATCH_URL=           # full endpoint URL, e.g. https://erp.lakecement.co.tz/dispatch_report
ODOO_DISPATCH_API_KEY=       # opaque key issued by the Odoo team for this endpoint
#
# 2b. Mining Report connector (services/odooMiningClient.js) — the fourth
#    bespoke controller, same server/key style. Delivered 2026-08-05 but
#    empty until 2026-09-08; now feeds weighbridge_tickets (the Quarry
#    dashboard) via services/odooMiningSync.js, replacing a manual Excel
#    upload. Moved to the PRODUCTION ERP 2026-09-23 alongside dispatch_report
#    above — now returns a real ticket_no per row too (odooMiningSync.js
#    prefers it over its content-hash surrogate). BOTH VARS ARE OPTIONAL:
#    when unset they are derived from the DISPATCH pair above (host + key,
#    endpoint name swapped) — mining and dispatch are siblings on the same
#    controller. They do NOT fall back to the dashboard pair below, which
#    may still point at a different server.
ODOO_MINING_URL=             # full endpoint URL, e.g. https://erp.lakecement.co.tz/mining_report
ODOO_MINING_API_KEY=         # opaque key, if different from the dispatch one
#
# 2c. Production Report connector (services/odooProductionClient.js) — the
#    fifth bespoke controller, delivered 2026-09-20 on the PRODUCTION ERP
#    (erp.lakecement.co.tz). Feeds the odoo_production_entries mirror (the
#    source for the daily production report's tonnages and consumption).
#    BOTH VARS ARE REQUIRED when used: there is deliberately NO fallback to
#    the dashboard/dispatch pairs. The same production key now also serves
#    dispatch_report, mining_report and the sale/purchase endpoints — as of
#    2026-09-23 all five bespoke controllers live on this one host/key.
#    Manual run: `npm run odoo:production-pull -- <from> <to> [--dry-run]`.
ODOO_PRODUCTION_URL=         # full endpoint URL, e.g. https://erp.lakecement.co.tz/production_report
ODOO_PRODUCTION_API_KEY=     # opaque key issued by the Odoo team for the production ERP
#
ODOO_SYNC_CRON=off            # cron spec for the daily pull; 'off' disables even if a URL above is set
# 3. Sales/Purchase dashboard endpoints (services/odooDashboardClient.js) —
#    two more bespoke controllers from the Odoo team, each returning a whole
#    dashboard's data for a date range. See that client's header for known
#    defects. Since 2026-09-19 these two are live on the PRODUCTION ERP
#    (https://erp.lakecement.co.tz, its own key) — as of 2026-09-23 the same
#    host/key as the dispatch and mining pair above, though this variable
#    pair remains independently configurable in case that ever changes.
ODOO_DASHBOARD_URL=          # base URL only, e.g. https://erp.lakecement.co.tz
ODOO_DASHBOARD_API_KEY=      # opaque key issued by the Odoo team for THAT server
#
# Dashboard cache warmer (services/dashboardCacheWarmer.js) — mitigates
# defect 3 above (sale_dashboard_report ignores the date filter, so every
# cold request costs 30-49s on production regardless of range) by pre-
# fetching the current month + trailing year on a schedule, so a real
# user viewing a past month is very unlikely to be the first to ask for
# it. Runs once at startup too. Manual run: `npm run dashboard:warm`.
DASHBOARD_WARM_CRON=off      # cron spec, e.g. '0 */6 * * *' (every 6h — inside the 12h closed-month cache TTL); 'off' disables. Needs ODOO_DASHBOARD_URL set
