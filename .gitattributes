# Vendored third-party files are byte-exact artefacts, not source.
#
# core.autocrlf is true on the Windows dev machines here, so without this
# rule git rewrites LF to CRLF on checkout — which changes the bytes of
# vendor/xlsx-0.18.5/xlsx.full.min.js and makes it fail the very SHA256SUMS
# file shipped beside it to prove it is the unmodified SheetJS 0.18.5
# release. `-text` tells git to leave these files exactly as committed.
#
# Verify after any checkout with:
#   sha256sum -c vendor/xlsx-0.18.5/SHA256SUMS
vendor/** -text

# Same rule, same reason, for the collaborator's Integration Package (Python,
# authored on Windows with CRLF): it is vendored byte-for-byte and checked
# against integration/sales-dashboard/SHA256SUMS, so git must not rewrite it.
#   sha256sum -c integration/sales-dashboard/SHA256SUMS
integration/sales-dashboard/** -text

# Shell scripts and nginx snippets run on the Linux droplet, and are often
# copied there straight from a Windows working copy (scp), where CRLF line
# endings make bash fail with "command not found" on every line. Keep them LF.
*.sh text eol=lf
deploy/*.conf text eol=lf
