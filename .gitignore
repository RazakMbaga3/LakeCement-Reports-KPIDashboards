# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
*.swp
*.swo

# Logs
*.log
backend/logs/

# Dependencies & secrets (belt-and-braces; backend/.gitignore also covers these)
node_modules/
.env
.env.local

# Excel lock/temp files (the .xlsx report templates themselves stay tracked)
~$*.xls*
*.tmp

# deploy/ is checked out onto the production droplet and gets read by
# external collaborators (see docs/DEPLOYMENT_DIGITALOCEAN.md) — it should
# only ever hold deployment scripts/configs, never real report data. A real
# filled production report was committed here by accident (2026-08-06,
# untracked 2026-08-19); this rule stops it from silently recurring. Root-
# level .xlsx files are unaffected — those are deliberate historical
# backfill source material, not this problem.
deploy/*.xls*

# Playwright end-to-end harness (e2e/) — browsers, run artifacts and reports
e2e/node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/.cache/

# Design-audit output — hundreds of screenshots and JSON dumps, regenerated
# by e2e/design-audit-screenshots.js and e2e/design-consistency-audit.js
e2e/design-audit/

# Integration Package (integration/sales-dashboard/): the collaborator's code is
# committed, but its runtime state never is. .env (Odoo DB password) is already
# ignored above; users.toml holds Streamlit password hashes; outbox/<date>/
# folders would hold prepared mails if anyone ran the scripts here.
integration/sales-dashboard/users.toml
integration/sales-dashboard/.venv/
integration/sales-dashboard/__pycache__/
integration/sales-dashboard/outbox/*/
integration/sales-dashboard/*.log
integration/sales-dashboard/*.xlsx
